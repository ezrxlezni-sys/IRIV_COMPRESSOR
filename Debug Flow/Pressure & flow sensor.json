    {
        "id": "b8eebc98299ec892",
        "type": "function",
        "z": "30c480cdacae5e10",
        "name": "Temperature",
        "func": "let r = msg.payload?.data || msg.payload;\n\nif (!Array.isArray(r) || r.length < 2) {\n    node.warn(\"No 2 registers received: \" + JSON.stringify(msg.payload));\n    return null;\n}\n\nlet buf = Buffer.alloc(4);\n\n// CDAB / word swap\nbuf.writeUInt16BE(r[1], 0);\nbuf.writeUInt16BE(r[0], 2);\n\nmsg.payload = buf.readFloatBE(0);\nreturn msg;",
