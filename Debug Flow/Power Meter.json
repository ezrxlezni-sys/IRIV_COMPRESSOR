    {
        "id": "06f8269ea27b5aeb",
        "type": "function",
        "z": "5ce278948e478be7",
        "name": "AvgVolt_1",
        "func": "// Ambil nilai dari setiap fasa\nlet v1 = msg.payload[\"Voltage L1\"];\nlet v2 = msg.payload[\"Voltage L2\"];\nlet v3 = msg.payload[\"Voltage L3\"];\n\n// Kira purata\nlet avg = (v1 + v2 + v3) / 3;\n\n// Tetapkan output\nmsg.topic = \"Average Voltage 1\";\ncontext.flow.avv1 = parseFloat(avg.toFixed(2));\nmsg.payload = context.flow.avv1;\nreturn msg;\n",
