    {
        "id": "baa5abf331ee3df3",
        "type": "function",
        "z": "5ce278948e478be7",
        "name": "adl400_L1_V",
        "func": "msg.topic = \"Voltage L1\";\n\n// Gabungkan dua 16-bit register jadi 32-bit float\nlet buf = Buffer.alloc(4);\nbuf.writeUInt16BE(msg.payload[0], 0);  // High word\nbuf.writeUInt16BE(msg.payload[1], 2);  // Low word\n\nlet v1 = buf.readFloatBE(0);      // Big Endian format\nmsg.payload = parseFloat(v1.toFixed(2));\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
