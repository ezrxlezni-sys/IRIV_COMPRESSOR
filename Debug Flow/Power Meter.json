        "name": "MQTT AV Amp",
        "func": "// Ambil nilai dari setiap fasa\nlet c1 = msg.payload[\"Current L1\"];\nlet c2 = msg.payload[\"Current L2\"];\nlet c3 = msg.payload[\"Current L3\"];\n\n// Kira purata\nlet avg = (c1 + c2 + c3) / 3;\n\n// Tetapkan output\nmsg.topic = \"v1.6/devices/iriv_cytron_ADL400\";\ncontext.flow.avc1 = parseFloat(avg.toFixed(2));\nmsg.payload = { average_current: context.flow.crn1};\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
