        "z": "5ce278948e478be7",
        "name": "adl400_Frequency",
        "func": "msg.topic = \"Energy Total\";\n\n// Pastikan anda baca 4 register berturut-turut (3004~3007)\nlet buf = Buffer.alloc(8);\nbuf.writeUInt16BE(msg.payload[0], 0);\nbuf.writeUInt16BE(msg.payload[1], 2);\nbuf.writeUInt16BE(msg.payload[2], 4);\nbuf.writeUInt16BE(msg.payload[3], 6);\n\nlet value = buf.readDoubleBE(0);   // 64-bit double (Big Endian)\ncontext.flow.enrg1 = parseFloat(value.toFixed(2))\nmsg.payload = context.flow.enrg1;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
